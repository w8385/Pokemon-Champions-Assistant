{
  "name": "pokemon-champions-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:champions-whitelist": "node scripts/build-champions-move-whitelist.mjs",
    "build:champions-learned-whitelist": "node scripts/build-champions-learned-move-whitelist.mjs",
    "build:champions-move-meta": "node scripts/build-champions-move-meta.mjs",
    "build:champions-usage-top-moves": "node scripts/build-champions-usage-top-moves.mjs",
    "check:type-effectiveness": "node scripts/check-type-effectiveness-harness.mjs",
    "check:damage-parity": "node scripts/check-damage-parity.mjs",
    "check:ability-damage": "node scripts/check-ability-damage-harness.mjs",
    "check:party-image-import": "node scripts/check-party-image-import-harness.mjs",
    "build:champions-item-whitelist": "node scripts/build-champions-item-whitelist.mjs",
    "sync:item-sprites": "node scripts/sync-item-sprites.mjs",
    "build:champion-sprite-hashes": "node scripts/build-champion-sprite-hashes.mjs",
    "check:ui-consistency": "python3 scripts/check-ui-consistency-harness.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
